    "%@ 目前讀不到，無法掃描。外接碟請確認已連接。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is unavailable and cannot be scanned. Check that the external drive is connected."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 目前讀不到，無法掃描。外接碟請確認已連接。"
          }
        }
      }
    },
